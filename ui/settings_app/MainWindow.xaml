<Window
    x:Class="MagicMouse.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicMouse.Settings"
    Title="Magic Mouse Settings">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="General"  Icon="Home"     Content="General"  />
                <NavigationViewItem Tag="Gestures" Icon="TouchPointer" Content="Gestures" />
                <NavigationViewItem Tag="Scroll"   Icon="Sync"     Content="Scroll"   />
            </NavigationView.MenuItems>

            <!-- Header bar -->
            <NavigationView.Header>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE962;" FontSize="24" />
                    <TextBlock Text="Magic Mouse" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.Header>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
