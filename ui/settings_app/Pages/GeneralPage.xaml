<Page
    x:Class="MagicMouse.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="8" MaxWidth="600">

            <!-- Section header -->
            <TextBlock Text="General" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

            <!-- Enable/Disable toggle -->
            <ToggleSwitch x:Name="EnableToggle"
                          Header="Enable Magic Mouse driver"
                          IsOn="True"
                          Toggled="EnableToggle_Toggled" />

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="False"
                     Margin="0,8,0,0" />

            <MenuFlyoutSeparator Margin="0,16,0,16" />

            <!-- Startup with Windows -->
            <ToggleSwitch x:Name="StartupToggle"
                          Header="Start with Windows"
                          IsOn="True"
                          Toggled="StartupToggle_Toggled" />

            <TextBlock Text="Adds tray_host.exe to your startup folder so Magic Mouse is always active."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,-4,0,0" />

            <MenuFlyoutSeparator Margin="0,16,0,16" />

            <!-- Version info -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Version:" Style="{ThemeResource BodyTextBlockStyle}" />
                <TextBlock x:Name="VersionText" Text="0.1.0"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
