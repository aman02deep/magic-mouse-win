<UserControl x:Class="MagicMouse.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="General" FontSize="24" FontWeight="SemiBold"/>

            <CheckBox x:Name="EnableToggle" Content="Enable Magic Mouse driver" IsChecked="True" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>

            <TextBlock x:Name="StatusBar" Visibility="Collapsed" Margin="0,10,0,10" FontWeight="SemiBold"/>

            <Separator Margin="0,15"/>

            <!-- ═══ Connected Device Panel ═══ -->
            <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Device Name -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Name="DeviceNameText"
                               Text="No device connected"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#8888AA"/>

                    <!-- Battery row -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="BatteryIcon" Text="🔋" FontSize="16" Margin="0,0,6,0"/>
                        <TextBlock x:Name="BatteryText" Text="--" FontSize="14" Foreground="#AAAACC"/>
                        <TextBlock x:Name="ChargingText" Text="" FontSize="13" Foreground="#66DDAA" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Magic Mouse interactive canvas -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                            Width="130" HorizontalAlignment="Center">
                        <Canvas x:Name="MouseCanvas" Width="110" Height="160"
                                HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- Mouse body shape (rounded rectangle) -->
                            <Rectangle Canvas.Left="5" Canvas.Top="0"
                                       Width="100" Height="155"
                                       RadiusX="50" RadiusY="50"
                                       Fill="#2D2D3A" Stroke="#555577" StrokeThickness="1.5"/>

                            <!-- Click divide line -->
                            <Line X1="55" Y1="0" X2="55" Y2="58"
                                  Stroke="#666688" StrokeThickness="1" Opacity="0.5"/>

                            <!-- Left button highlight -->
                            <Rectangle Canvas.Left="5" Canvas.Top="0"
                                       Width="49" Height="58"
                                       RadiusX="40" RadiusY="30"
                                       Fill="#35354A" Stroke="Transparent"/>

                            <!-- Right button highlight -->
                            <Rectangle Canvas.Left="56" Canvas.Top="0"
                                       Width="49" Height="58"
                                       RadiusX="30" RadiusY="30"
                                       Fill="#35354A" Stroke="Transparent"/>

                            <!-- Touch surface area (lower body) - subtle highlight -->
                            <Rectangle Canvas.Left="5" Canvas.Top="55"
                                       Width="100" Height="100"
                                       RadiusX="48" RadiusY="30"
                                       Fill="#28283A" Stroke="Transparent"/>

                            <!-- Apple logo placeholder (subtle) -->
                            <Ellipse Canvas.Left="44" Canvas.Top="72"
                                     Width="22" Height="22"
                                     Fill="#333348" Stroke="#44445A" StrokeThickness="1"/>

                            <!-- Touch dots will be added here dynamically from code-behind -->
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Startup option ═══ -->
            <CheckBox x:Name="StartupToggle" Content="Start with Windows" IsChecked="True" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"/>
            <TextBlock Text="Adds tray_host.exe to your startup folder so Magic Mouse is always active." FontSize="12" Foreground="Gray"/>

            <Separator Margin="0,15"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Version: "/>
                <TextBlock x:Name="VersionText" FontWeight="Bold"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
