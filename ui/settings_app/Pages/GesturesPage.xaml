<Page
    x:Class="MagicMouse.Settings.Pages.GesturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="8" MaxWidth="600">

            <TextBlock Text="Gestures" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

            <!-- Two-finger swipe -->
            <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C4;" />
                        <TextBlock Text="Two-finger swipe (page navigation)" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="16,8,16,16">
                    <ToggleSwitch x:Name="SwipeEnabled" Header="Enable" IsOn="True"
                                  Toggled="Gesture_Toggled" Tag="swipe_enabled" />
                    <TextBlock Text="Sensitivity" />
                    <Slider x:Name="SwipeSensitivity" Minimum="1" Maximum="10" Value="5"
                            TickFrequency="1" TickPlacement="Outside"
                            ValueChanged="Sensitivity_Changed" Tag="swipe_sensitivity" />
                </StackPanel>
            </Expander>

            <!-- Three-finger swipe -->
            <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C4;" />
                        <TextBlock Text="Three-finger swipe (Mission Control / Task View)" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="16,8,16,16">
                    <ToggleSwitch x:Name="ThreeFingerEnabled" Header="Enable" IsOn="True"
                                  Toggled="Gesture_Toggled" Tag="three_finger_enabled" />
                    <TextBlock Text="Sensitivity" />
                    <Slider x:Name="ThreeFingerSensitivity" Minimum="1" Maximum="10" Value="5"
                            TickFrequency="1" TickPlacement="Outside"
                            ValueChanged="Sensitivity_Changed" Tag="three_finger_sensitivity" />
                </StackPanel>
            </Expander>

            <!-- Tap-to-click -->
            <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C5;" />
                        <TextBlock Text="Tap to click" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="16,8,16,16">
                    <ToggleSwitch x:Name="TapClickEnabled" Header="Enable" IsOn="False"
                                  Toggled="Gesture_Toggled" Tag="tap_click_enabled" />
                </StackPanel>
            </Expander>

            <!-- Smart zoom -->
            <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A3;" />
                        <TextBlock Text="Smart zoom (double-tap)" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="16,8,16,16">
                    <ToggleSwitch x:Name="SmartZoomEnabled" Header="Enable" IsOn="True"
                                  Toggled="Gesture_Toggled" Tag="smart_zoom_enabled" />
                </StackPanel>
            </Expander>

            <Button x:Name="SaveButton" Content="Save changes" Style="{ThemeResource AccentButtonStyle}"
                    Click="SaveButton_Click" Margin="0,16,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
