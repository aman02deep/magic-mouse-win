<UserControl x:Class="MagicMouse.Settings.Pages.ScrollPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Scroll" Style="{StaticResource TitleText}"/>
            
            <CheckBox x:Name="NaturalScrollToggle" Content="Natural scrolling" Checked="NaturalScroll_Toggled" Unchecked="NaturalScroll_Toggled"/>
            <TextBlock Text="Content moves in the same direction as your finger (like macOS)." Style="{StaticResource CaptionText}"/>
            
            <Separator Margin="0,15"/>
            
            <TextBlock Text="Scroll speed" Style="{StaticResource SubTitleText}"/>
            <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="Speed_Changed"/>
            
            <Separator Margin="0,15"/>
            
            <CheckBox x:Name="InertiaToggle" Content="Momentum / inertia scrolling" Checked="Inertia_Toggled" Unchecked="Inertia_Toggled"/>
            <TextBlock Text="Continues scrolling after you lift your finger, decelerating smoothly." Style="{StaticResource CaptionText}"/>
            
            <StackPanel x:Name="InertiaPanel" Margin="0,10,0,0">
                <TextBlock Text="Inertia friction" Style="{StaticResource SubTitleText}"/>
                <Slider x:Name="FrictionSlider" Minimum="1" Maximum="10" Value="4" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="Friction_Changed"/>
                <TextBlock Text="Lower = longer coast; higher = snappier stop." Style="{StaticResource CaptionText}"/>
            </StackPanel>
            
            <Separator Margin="0,15"/>
            
            <TextBlock Text="Acceleration curve" Style="{StaticResource SubTitleText}"/>
            <ComboBox x:Name="CurveCombo" SelectedIndex="1" SelectionChanged="Curve_Changed">
                <ComboBoxItem Content="Linear" />
                <ComboBoxItem Content="Ease-in-out (recommended)" />
                <ComboBoxItem Content="Aggressive" />
            </ComboBox>
            
            <TextBlock x:Name="StatusBar" Visibility="Collapsed" Margin="0,10,0,0" FontWeight="SemiBold"/>
            <Button x:Name="SaveButton" Content="Save changes" Click="SaveButton_Click" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
