<?xml version="1.0" encoding="utf-8"?>
<!--
    WiX v4 installer for Magic Mouse Windows.
    Build: wix build MagicMouse.wxs -o MagicMouse.msi
    Requires WiX v4 CLI: dotnet tool install --global wix
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="Magic Mouse"
      Manufacturer="MagicMouse Contributors"
      Version="0.1.0"
      UpgradeCode="B3A4C5D6-E7F8-9012-ABCD-EF1234567890"
      InstallerVersion="500"
      Compressed="true">

    <!-- Allow major upgrades (uninstall old, install new automatically) -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Magic Mouse is already installed." />

    <!-- Single compressed cabinet -->
    <MediaTemplate EmbedCab="true" />

    <!-- ── Install directory ──────────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MagicMouse">

        <!-- ── Main binaries ────────────────────────────────────────────── -->
        <Component Id="ServiceBinary" Guid="A1B2C3D4-E5F6-7890-ABCD-111122223333">
          <File Id="ServiceExe"
                Source="$(var.BuildDir)\service\Release\magic_mouse_service.exe"
                KeyPath="yes" />

          <!-- Register + auto-start the Windows service -->
          <ServiceInstall
              Id="MagicMouseServiceInstall"
              Name="MagicMouseService"
              DisplayName="Magic Mouse Service"
              Description="Handles Magic Mouse Bluetooth HID input and gesture translation."
              Type="ownProcess"
              Start="auto"
              ErrorControl="normal"
              Account="LocalSystem" />

          <ServiceControl
              Id="StartService"
              Name="MagicMouseService"
              Start="install"
              Stop="both"
              Remove="uninstall"
              Wait="yes" />
        </Component>

        <Component Id="TrayHostBinary" Guid="B2C3D4E5-F6A7-8901-BCDE-222233334444">
          <File Id="TrayHostExe"
                Source="$(var.BuildDir)\tools\tray_host\Release\tray_host.exe"
                KeyPath="yes" />

          <!-- Launch tray host at user login -->
          <RegistryValue
              Root="HKCU"
              Key="Software\Microsoft\Windows\CurrentVersion\Run"
              Name="MagicMouseTrayHost"
              Type="string"
              Value="&quot;[INSTALLFOLDER]tray_host.exe&quot;"
              KeyPath="no" />
        </Component>

        <Component Id="SettingsAppBinary" Guid="C3D4E5F6-A7B8-9012-CDEF-333344445555">
          <File Id="SettingsAppExe"
                Source="$(var.BuildDir)\ui\settings_app\settings_app.exe"
                KeyPath="yes" />
        </Component>

        <!-- ── Default config ────────────────────────────────────────────── -->
        <Directory Id="ConfigDir" Name="configs">
          <Component Id="DefaultConfig" Guid="D4E5F6A7-B8C9-0123-DEFA-444455556666">
            <File Id="DefaultJson"
                  Source="$(var.SourceDir)\configs\default.json"
                  KeyPath="yes" />
          </Component>
        </Directory>

      </Directory>
    </StandardDirectory>

    <!-- ── Start Menu shortcut ── ────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Magic Mouse">
        <Component Id="StartMenuShortcut" Guid="E5F6A7B8-C9D0-1234-EFAB-555566667777">
          <Shortcut Id="SettingsShortcut"
                    Name="Magic Mouse Settings"
                    Description="Configure Magic Mouse for Windows"
                    Target="[INSTALLFOLDER]settings_app.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\MagicMouse"
                         Name="StartMenuInstalled"
                         Type="integer" Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ── Feature tree ───────────────────────────────────────────────────── -->
    <Feature Id="MainFeature" Title="Magic Mouse" Level="1">
      <ComponentRef Id="ServiceBinary" />
      <ComponentRef Id="TrayHostBinary" />
      <ComponentRef Id="SettingsAppBinary" />
      <ComponentRef Id="DefaultConfig" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>
</Wix>
